# Copia este archivo como ".env" y reemplaza los valores con los tuyos. NO subas ".env" a Git.
DB_URL=jdbc:postgresql://HOST:5432/NOMBRE_BD?sslmode=require
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña
PORT=8080
# Opcional: CORS_ORIGENES=http://localhost:5173
# Opcional: SEED_DATA=true  (carga datos de ejemplo si la BD está vacía)
